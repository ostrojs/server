{
    "name": "@ostro/server",
    "version": "2.0.0-alpha.1",
    "description": "Server module for OstroJS",
    "main": "build/server.js",
    "types": "build/server.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/server.d.ts",
            "default": "./build/server.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "start": "node build/server.js",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "finalhandler": "^1.1.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "server",
        "nodejs server",
        "http server"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/server.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/server/issues"
    },
    "homepage": "https://github.com/ostrojs/server#readme",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    }
}
